# Front-end (entram no build: novo deploy após mudar)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-from-supabase-dashboard
VITE_N8N_BASE_URL=https://seu-n8n.exemplo.com

# Servidor (/api na Vercel) — nunca use prefixo VITE_ nestas
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# A Evolution de cada escritório fica em Configurações (company_settings).
# EVOLUTION_URL / EVOLUTION_API_KEY / INSTANCE_NAME são só reserva: remova da Vercel
# se apontarem para um servidor antigo.
N8N_DOCUMENTOS_WEBHOOK=https://seu-n8n.exemplo.com/webhook/conta/documentos
# N8N_ALLOWED_HOSTS=outro-n8n.exemplo.com

# Google Drive do escritório (docs/google-drive.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Textos aleatórios longos (32+). CONTA_SECRET não deve ser trocado depois de conectar um Drive.
CONTA_SECRET=
CONTA_INTERNAL_KEY=
APP_URL=https://seu-app.vercel.app
