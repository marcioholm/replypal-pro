{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/evolution-webhook/(.*)",
      "destination": "/api/evolution-webhook"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/proxy-webhook.ts": {
      "maxDuration": 30
    },
    "api/google.ts": {
      "maxDuration": 30
    },
    "api/evolution-webhook.ts": {
      "maxDuration": 30
    }
  }
}
