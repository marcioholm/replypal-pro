{
  "name": "Conta+ · Documentos",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "conta/documentos",
        "options": {}
      },
      "id": "node-webhook",
      "name": "Webhook Documentos",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT bot_documentos_ativo FROM public.company_settings WHERE tenant_id = $1::uuid LIMIT 1;",
        "additionalFields": {
          "queryParams": "={{ $json.body.tenant_id }}"
        }
      },
      "id": "node-check-bot-ativo",
      "name": "Verificar Bot Ativo",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [320, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.bot_documentos_ativo }}",
              "value2": true
            }
          ]
        }
      },
      "id": "node-if-bot-ativo",
      "name": "Bot está ativo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [520, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM public.pedidos_documento WHERE tenant_id = $1::uuid AND public.mesmo_telefone(telefone, $2) AND status IN ('aguardando_cliente', 'escolher_empresa') AND created_at >= now() - interval '15 minutes' ORDER BY created_at DESC LIMIT 1;",
        "additionalFields": {
          "queryParams": "={{ $('Webhook Documentos').item.json.body.tenant_id }}, {{ $('Webhook Documentos').item.json.body.telefone }}"
        }
      },
      "id": "node-check-pedido-aberto",
      "name": "Buscar Pedido Aberto (<15 min)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [740, 200]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.id }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "node-if-tem-pedido",
      "name": "Tem pedido aberto?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [960, 200]
    },
    {
      "parameters": {
        "jsCode": "const texto = ($('Webhook Documentos').item.json.body.texto || '').trim().toLowerCase();\nconst pedido = $json;\n\nif (['1', 'sim', 'isso', 'pode', 'quero', 'por favor'].includes(texto)) {\n  return [{ json: { acao_cliente: 'confirmou', pedido_id: pedido.id } }];\n} else if (['2', 'nao', 'não', 'cancela', 'cancelar'].includes(texto)) {\n  return [{ json: { acao_cliente: 'cancelou', pedido_id: pedido.id } }];\n} else if (pedido.status === 'escolher_empresa' && !isNaN(parseInt(texto))) {\n  return [{ json: { acao_cliente: 'escolheu_empresa', indice: parseInt(texto), pedido_id: pedido.id } }];\n}\n\nreturn [{ json: { acao_cliente: 'outro', pedido_id: pedido.id } }];"
      },
      "id": "node-analisa-resposta",
      "name": "Analisar Resposta Confirmação",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1180, 100]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.acao_cliente }}",
        "rules": {
          "rules": [
            { "value2": "confirmou" },
            { "value2": "cancelou" }
          ]
        }
      },
      "id": "node-switch-resposta",
      "name": "Ação do Cliente",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [1380, 100]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT public.confirmar_pedido_documento($1::uuid) AS resultado;",
        "additionalFields": {
          "queryParams": "={{ $json.pedido_id }}"
        }
      },
      "id": "node-rpc-confirmar",
      "name": "RPC Confirmar Pedido",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [1600, 40]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE public.pedidos_documento SET status = 'cancelado' WHERE id = $1::uuid;",
        "additionalFields": {
          "queryParams": "={{ $json.pedido_id }}"
        }
      },
      "id": "node-cancelar-pedido",
      "name": "Cancelar Pedido",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [1600, 180]
    },
    {
      "parameters": {
        "jsCode": "const texto = ($('Webhook Documentos').item.json.body.texto || '').toLowerCase();\nconst palavras = [\n  'contrato', 'social', 'cartão', 'cartao', 'cnpj', 'certificado',\n  'guia', 'das', 'boleto', 'honorário', 'honorario', 'folha',\n  'holerite', 'alvará', 'alvara', 'faturamento', 'compras', 'vendas'\n];\n\nconst temPalavra = palavras.some(p => texto.includes(p));\nreturn [{ json: { tem_palavra: temPalavra, texto } }];"
      },
      "id": "node-filtro-barato",
      "name": "Filtro Barato Palavras",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1180, 320]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.tem_palavra }}",
              "value2": true
            }
          ]
        }
      },
      "id": "node-if-tem-palavra",
      "name": "Tem palavra-chave?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1380, 320]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0
        },
        "prompt": "=Você é o classificador do sistema contábil Conta+.\nAnalise o texto do cliente e classifique se é um PEDIDO de documento para envio.\n\nTipos válidos:\n- cartao_cnpj\n- alvara\n- documentos_fiscais\n- boletos_honorarios\n- contrato_social\n- folha_pagamento\n- faturamento\n- compras\n- vendas\n- certificado_digital\n\nRegras:\n- Se o cliente apenas fez uma dúvida ou pergunta sobre o documento (ex: 'o contrato precisa de alteração?'), pedido é false.\n- Se o cliente pediu para enviar/receber o documento, pedido é true e tipo é um dos acima.\n\nTexto do cliente: \"{{ $json.texto }}\"\n\nResponda ESTRITAMENTE em formato JSON sem markdown:\n{\"pedido\": true|false, \"tipo\": \"<tipo>\"|null}"
      },
      "id": "node-ia-classifica",
      "name": "IA Classifica Pedido (JSON)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [1600, 320]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT public.resolver_pedido_documento($1::uuid, $2, $3, $4::uuid, $5) AS resultado;",
        "additionalFields": {
          "queryParams": "={{ $('Webhook Documentos').item.json.body.tenant_id }}, {{ $('Webhook Documentos').item.json.body.telefone }}, {{ $json.tipo }}, {{ $('Webhook Documentos').item.json.body.conversa_id }}, {{ $('Webhook Documentos').item.json.body.texto }}"
        }
      },
      "id": "node-rpc-resolver",
      "name": "RPC Resolver Pedido",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [1820, 320]
    },
    {
      "parameters": {
        "jsCode": "const res = $json.resultado || {};\nlet mensagem = '';\n\nswitch (res.decisao) {\n  case 'confirmar_com_cliente':\n    mensagem = `Você quer receber o ${res.rotulo} da ${res.empresa}? Responda 1 para sim ou 2 para não.`;\n    break;\n  case 'escolher_empresa':\n    const lista = (res.empresas || []).map((e, idx) => `${idx + 1}. ${e.empresa}`).join('\\n');\n    mensagem = `De qual empresa você deseja o documento?\\n${lista}`;\n    break;\n  case 'nao_autorizado':\n    mensagem = 'Não encontrei seu cadastro para receber documentos por aqui. Um atendente já vai te ajudar.';\n    break;\n  case 'sem_documento':\n    mensagem = 'Não achei esse documento no sistema. Um atendente já vai te ajudar.';\n    break;\n  case 'bloqueado':\n    mensagem = 'Esse documento é tratado só com a nossa equipe. Um atendente já vai te ajudar.';\n    break;\n  default:\n    break;\n}\n\nreturn [{ json: { mensagem, decisao: res.decisao, pedido_id: res.pedido_id } }];"
      },
      "id": "node-monta-resposta",
      "name": "Montar Resposta Resolver",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2040, 320]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.mensagens (conversation_id, content, sender, sender_name, type, status, tenant_id) VALUES ($1::uuid, $2, 'agent', 'Conta+ (automático)', 'text', 'sent', $3::uuid);",
        "additionalFields": {
          "queryParams": "={{ $('Webhook Documentos').item.json.body.conversa_id }}, {{ $json.mensagem }}, {{ $('Webhook Documentos').item.json.body.tenant_id }}"
        }
      },
      "id": "node-gravar-mensagem-bot",
      "name": "Gravar Mensagem Bot em Mensagens",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [2260, 320]
    }
  ],
