        "jsCode": "const base = $('Decidir caminho').item.json;\nlet c = {};\ntry { c = JSON.parse($json.choices?.[0]?.message?.content || '{}'); } catch (e) {}\nconst tipos = [\"cartao_cnpj\", \"alvara\", \"documentos_fiscais\", \"boletos_honorarios\", \"contrato_social\", \"folha_pagamento\", \"faturamento\", \"compras\", \"vendas\", \"certificado_digital\"];\nreturn [{ json: { ...base, eh_pedido: c.pedido === true && tipos.includes(c.tipo), tipo: c.tipo } }];"
