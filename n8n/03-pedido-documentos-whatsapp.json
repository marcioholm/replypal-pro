    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  coalesce(cs.bot_documentos_ativo, false) AS ativo,\n  public.evolution_config($1::uuid) AS evolution,\n  public.telefone_whatsapp($2) AS numero,\n  (SELECT row_to_json(p) FROM public.pedidos_documento p\n    WHERE p.tenant_id = $1::uuid AND public.mesmo_telefone(p.telefone, $2)\n      AND p.status IN ('aguardando_cliente', 'escolher_empresa')\n      AND p.created_at > now() - interval '15 minutes'\n    ORDER BY p.created_at DESC LIMIT 1) AS pedido\nFROM public.company_settings cs WHERE cs.tenant_id = $1::uuid",
        "options": {
          "queryReplacement": "={{ [ $json.body.tenant_id, $json.body.telefone ] }}"
        }
      },
      "id": "7cdbe043-807a-5e76-b3d6-57c1692d1fd5",
      "name": "Carregar contexto",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        440,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "contaPostgres",
          "name": "Conta+ · Supabase (Postgres)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const ent = $('Config').item.json;\nconst b = ent.body || {};\nconst texto = String(b.texto || '').trim();\nconst t = texto.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');\nconst p = $json.pedido;\nlet caminho = 'ignorar';\nlet escolha = null;\nif ($json.ativo) {\n  if (p && p.status === 'escolher_empresa' && /^\\d{1,2}$/.test(t)) { caminho = 'escolher'; escolha = parseInt(t, 10); }\n  else if (p && p.status === 'aguardando_cliente' && /^(1|sim|s|isso|pode|quero|ok|claro)\\b/.test(t)) caminho = 'confirmar';\n  else if (p && /^(2|nao|n|cancela|deixa)\\b/.test(t)) caminho = 'cancelar';\n  else if (/(contrato|social|cartao|cnpj|certificado|guia|\\bdas\\b|boleto|honorario|folha|holerite|alvara|faturamento|compras|vendas)/.test(t)) caminho = 'classificar';\n}\nreturn [{ json: {\n  config: ent.config, caminho, escolha, texto,\n  tenant_id: b.tenant_id, conversa_id: b.conversa_id, telefone: b.telefone,\n  numero: $json.numero, evolution: $json.evolution, pedido: p,\n}}];"
      },
