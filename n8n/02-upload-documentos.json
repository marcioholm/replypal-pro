              "id": "c42b85f6-0bc7-5b05-8013-4f241a151737",
              "leftValue": "={{ !$json.erro }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
