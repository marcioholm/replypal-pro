      "id": "0652d229-83fb-565f-9781-9075adbe57b6",
      "name": "Reservar mensagens",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        440,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "contaPostgres",
          "name": "Conta+ · Supabase (Postgres)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "function corpoTexto(numero, texto, v1) {\n  return v1 ? { number: numero, textMessage: { text: texto } } : { number: numero, text: texto };\n}\nfunction corpoMidia(numero, url, tipo, nome, legenda, v1) {\n  const m = { mediatype: tipo || 'document', media: url, fileName: nome || 'arquivo', caption: legenda || '' };\n  return v1 ? { number: numero, mediaMessage: m } : { number: numero, ...m };\n}\nfunction endpoint(evo, caminho) {\n  return `${String(evo.url || '').replace(/\\/$/, '')}/message/${caminho}/${encodeURIComponent(evo.instance || '')}`;\n}\n\nconst v1 = $('Config').first().json.config.EVOLUTION_V1;\nreturn $input.all().map(({ json: m }) => {\n  const midia = m.message_type && m.message_type !== 'text';\n  return { json: { ...m, req: {\n    url: endpoint(m.evolution, midia ? 'sendMedia' : 'sendText'),\n    headers: { apikey: m.evolution.apikey },\n    body: midia\n      ? corpoMidia(m.numero, m.media_url, m.message_type, m.file_name, m.text_content, v1)\n      : corpoTexto(m.numero, m.text_content, v1),\n  }}};\n});"
      },
      "id": "f9a4b6fe-15d2-540c-8087-adfde16b55c0",
      "name": "Montar envio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.req.url }}",
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify($json.req.headers || {}) }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.req.body) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "87882ba1-7b29-5971-b7ee-75f8ba44b2c5",
      "name": "Enviar pela Evolution",
