{
  "name": "Conta+ 02 · Upload de documentos",
  "nodes": [
    {
      "parameters": {
        "content": "## 02 · Upload de documentos\nChamado pela aba Documentos do cliente (POST /webhook/documentos/upload, via /api/proxy-webhook).\n\nGuarda o arquivo no bucket **privado** `documentos` do Supabase e cria a linha em `documentos`. O app abre e envia sempre por link assinado (/api/documento-url).\n\nLimite: 15 MB por arquivo.",
        "height": 260,
        "width": 460
      },
      "id": "458aedfc-b5c2-52ab-a602-66de7ba8a805",
      "name": "Nota 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -320
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "documentos/upload",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "2c12d322-9905-579f-b7f0-b064b252cb18",
      "name": "Webhook upload",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "9dd8e685-bc01-5abd-a81a-27955e0ed87d"
    },
    {
      "parameters": {
        "jsCode": "// ⚙️ CONFIGURAÇÃO — preencha uma vez\nreturn [{ json: {\n  ...$json,\n  config: {\n    SUPABASE_URL: 'https://SEU-PROJETO.supabase.co',   // sem barra no final\n    APP_URL: 'https://SEU-APP.vercel.app',              // endereço do Conta+, sem barra no final\n    EVOLUTION_V1: false,                                // true se a sua Evolution for v1.x\n    MODELO_IA: 'gpt-4.1-mini',\n  }\n}}];"
      },
      "id": "ce7b6223-3581-52f8-8ec0-4dfa386dba38",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = { ...($json.body || {}) };\n// aceita base64 puro ou data URL (\"data:application/pdf;base64,....\")\nb.arquivo_base64 = String(b.arquivo_base64 || '').replace(/^data:[^,]*,/, '');\nconst uuidOk = s => /^[0-9a-f-]{36}$/i.test(s || '');\nconst erros = [];\nif (!uuidOk(b.cliente_id)) erros.push('cliente_id');\nif (!b.arquivo_base64) erros.push('arquivo');\nif (!b.tipo) erros.push('tipo');\nconst bytes = Math.floor(String(b.arquivo_base64 || '').length * 3 / 4);\nif (bytes > 15 * 1024 * 1024) erros.push('arquivo maior que 15 MB');  // pelo app o limite real é 3 MB (proxy da Vercel)\nconst limpo = String(b.arquivo_nome || 'arquivo').normalize('NFD').replace(/[̀-ͯ]/g, '')\n  .replace(/[^a-zA-Z0-9._-]+/g, '-').slice(-80);\nreturn [{ json: { config: $json.config, b, bytes, nome_limpo: limpo, erro: erros.join(', ') } }];"
      },
      "id": "e5c5e88a-86f8-5950-b71d-b7c74bdb7177",
      "name": "Validar arquivo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
