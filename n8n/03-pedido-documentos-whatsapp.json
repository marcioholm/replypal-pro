        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Config').item.json.config.MODELO_IA, temperature: 0.2, response_format: { type: 'json_object' }, messages: [\n  { role: 'system', content: 'Você lê mensagens de clientes de um escritório de contabilidade. Responda só JSON: {\"pedido\": true|false, \"tipo\": \"cartao_cnpj|alvara|documentos_fiscais|boletos_honorarios|contrato_social|folha_pagamento|faturamento|compras|vendas|certificado_digital\" ou null}. pedido=true só se a pessoa está PEDINDO para receber o documento agora. Perguntas sobre o documento (prazo, alteração, dúvida) são pedido=false. guia, DAS, DARF, GPS e notas = documentos_fiscais; holerite = folha_pagamento; boleto do escritório = boletos_honorarios.' },\n  { role: 'user', content: $json.texto }\n] }) }}",
